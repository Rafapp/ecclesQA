{
  "name": "fantasia-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "secrets": {
    "required": ["SITE_PASSWORD", "SESSION_SECRET"]
  },
  "assets": {
    "directory": "../worker-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
